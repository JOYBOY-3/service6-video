    {
      "type": "text",
      "version": 353,
      "versionNonce": 191876324,
      "isDeleted": false,
      "id": "7uV6_3Q2m1WQGC9AXQ06g",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1626.0419478503716,
      "y": 1407.2647376215846,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "width": 905.039306640625,
      "height": 96,
      "seed": 456201998,
      "groupIds": [],
      "roundness": null,
      "boundElements": [],
      "updated": 1786531599122,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 1,
      "text": "In reality however, there is no CPU affinity and threads are subject to 10ms time slices.\nThis means the full configured time for every cycle could be spent on any CPU and when or\nwhich CPU that happens on will change on every cycle. The key here is that K8s will allow\nService1 to always have 125ms of time on a CPU when it’s needed on every cycle.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In reality however, there is no CPU affinity and threads are subject to 10ms time slices.\nThis means the full configured time for every cycle could be spent on any CPU and when or\nwhich CPU that happens on will change on every cycle. The key here is that K8s will allow\nService1 to always have 125ms of time on a CPU when it’s needed on every cycle.",
      "index": "b1q",
      "frameId": null,
      "autoResize": true,
      "lineHeight": 1.2
    },
